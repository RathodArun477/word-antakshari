# Root .gitignore for Word Antakshari Project

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/
backend/__pycache__/
backend/backend_output.log
backend/feedback.json
feedback.json

# Virtual Environments
venv/
venv_win/
.venv/
env/
ENV/
backend/venv/
backend/venv_win/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/

# --- Environment & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDEs and Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- Documentation ---
*.md

